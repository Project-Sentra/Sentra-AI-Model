# SentraAI Service Configuration
# Copy this file to .env and adjust. Never commit the real .env file.

# Server settings
PORT=5001
HOST=0.0.0.0
DEBUG=false

# Camera mode: simulated | live
# simulated: loops the sample video for testing
# live: uses the IP camera sources below
CAMERA_MODE=simulated

# Camera sources (file path, device index, or rtsp:// URL)
ENTRY_CAMERA_SOURCE=../sample_videos/sample_video.mp4
EXIT_CAMERA_SOURCE=../sample_videos/sample_video.mp4

# Parking system backend URL
PARKING_API_URL=http://127.0.0.1:5000

# Shared secret sent as X-Service-Key to the backend.
# Must be identical to SERVICE_API_KEY in Sentra-Web/admin_backend/.env
SERVICE_API_KEY=replace_with_a_long_random_secret

# Facility (car park) these cameras belong to
FACILITY_ID=1

# Detection settings
MIN_CONFIDENCE=0.6
DETECTION_COOLDOWN=3

# Auto entry/exit mode
# true: automatically process entry/exit without confirmation
# false: show confirmation popup for operator
AUTO_ENTRY_EXIT=false

# Frame processing
FRAME_SKIP=2
FRAME_WIDTH=640
FRAME_HEIGHT=480
JPEG_QUALITY=80
